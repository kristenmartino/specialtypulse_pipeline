# Current deployment uses Databricks, Airflow and the standalone React dashboard.
# Configure OAuth with: databricks auth login --host WORKSPACE_URL --profile SPECIALTYPULSE
DATABRICKS_HOST=
DATABRICKS_CONFIG_PROFILE=SPECIALTYPULSE
# An optional deployment token may be configured locally; do not commit it.
DATABRICKS_TOKEN=
SPECIALTYPULSE_DATABRICKS_JOB_ID=
