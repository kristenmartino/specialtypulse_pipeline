{
  "name": "specialtypulse-dashboard",
  "version": "1.0.0",
  "description": "Specialty review dashboard using validated Spark exports",
  "scripts": {
    "dev": "webpack serve --mode development",
    "generate:data": "node scripts/generate-source-data.mjs",
    "prebuild": "npm run generate:data",
    "prebuild:web": "npm run generate:data",
    "build": "WEB_BUILD=1 webpack --mode production",
    "build:web": "WEB_BUILD=1 webpack --mode production",
    "start": "webpack serve --mode development",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
